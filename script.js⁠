// Inisialisasi Dasar
AOS.init({
    duration: 800,
    once: true,
    offset: 100,
    easing: 'ease-out-cubic'
});

// Scroll Halus Lenis
const lenis = new Lenis({
    duration: 1.2,
    easing: t => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    smooth: true,
    smoothTouch: true
});

function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
}
requestAnimationFrame(raf);

// Layar Loading Sinematik
const pesanMuat = [
    'Menginisialisasi Cyber Lab...',
    'Memuat Aset Digital...',
    'Menghubungkan Inti AI...',
    'Mengaktifkan Keamanan...',
    'Selamat Datang di Masa Depan ✨'
];
let indeksPesan = 0;
let persenMuat = 0;

const prosesMuat = setInterval(() => {
    persenMuat += Math.floor(Math.random() * 12) + 3;
    if (persenMuat >= 100) {
        persenMuat = 100;
        clearInterval(prosesMuat);
        setTimeout(() => {
            document.getElementById('layarMuat').classList.add('selesai');
        }, 800);
    }
    if (persenMuat >= 20 && indeksPesan === 0) {
        document.getElementById('teksMuat').textContent = pesanMuat[1];
        indeksPesan++;
    }
    if (persenMuat >= 40 && indeksPesan === 1) {
        document.getElementById('teksMuat').textContent = pesanMuat[2];
        indeksPesan++;
    }
    if (persenMuat >= 60 && indeksPesan === 2) {
        document.getElementById('teksMuat').textContent = pesanMuat[3];
        indeksPesan++;
    }
    if (persenMuat >= 85 && indeksPesan === 3) {
        document.getElementById('teksMuat').textContent = pesanMuat[4];
        indeksPesan++;
    }
    document.getElementById('barMuat').style.width = `${persenMuat}%`;
}, 150);

// Efek Mengetik
new Typed('#teksKetik', {
    strings: ['Pengembang Web', 'Desainer UI/UX', 'Peneliti Keamanan Digital', 'Pelajar Teknologi'],
    typeSpeed: 100,
    backSpeed: 60,
    backDelay: 2000,
    loop: true
});

// Latar Belakang 3D Galaksi
const kanvas3d = document.getElementById('latar3d');
const pengatur = new THREE.WebGLRenderer({
    canvas: kanvas3d,
    alpha: true,
    antialias: true,
    powerPreference: 'high-performance'
});
pengatur.setPixelRatio(Math.min(window.devicePixelRatio, 2));
pengatur.setSize(window.innerWidth, window.innerHeight);

const adegan = new THREE.Scene();
const kamera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
kamera.position.z = 180;

// Membuat Partikel Bintang
const geometriBintang = new THREE.BufferGeometry();
const jumlahBintang = 8000;
const posisiBintang = new Float32Array(jumlahBintang * 3);

for (let i = 0; i < jumlahBintang * 3; i++) {
    posisiBintang[i] = (Math.random() - 0.5) * 1200;
}

geometriBintang.setAttribute('position', new THREE.BufferAttribute(posisiBintang, 3));
const bahanBintang = new THREE.PointsMaterial({
    color: 0x00E5FF,
    size: 1.1,
    transparent: true,
    opacity: 0.6
});
const bintang = new THREE.Points(geometriBintang, bahanBintang);
adegan.add(bintang);

// Animasi Latar 3D
function putarLatar() {
    requestAnimationFrame(putarLatar);
    bintang.rotation.y += 0.0003;
    bintang.rotation.x += 0.0001;
    pengatur.render(adegan, kamera);
}
putarLatar();

// Sesuaikan Ukuran Saat Jendela Berubah
window.addEventListener('resize', () => {
    kamera.aspect = window.innerWidth / window.innerHeight;
    kamera.updateProjectionMatrix();
    pengatur.setSize(window.innerWidth, window.innerHeight);
});

// Kursor Khusus
const kursorUtama = document.getElementById('kursorUtama');
const kursorTrail = document.getElementById('kursorTrail');
let xKursor = 0, yKursor = 0, xTrail = 0, yTrail = 0;

window.addEventListener('mousemove', (e) => {
    xKursor = e.clientX;
    yKursor = e.clientY;
});

gsap.ticker.add(() => {
    xTrail += (xKursor - xTrail) * 0.12;
    yTrail += (yKursor - yTrail) * 0.12;
    
    kursorUtama.style.left = `${xKursor - 10}px`;
    kursorUtama.style.top = `${yKursor - 10}px`;
    kursorTrail.style.left = `${xTrail - 6}px`;
    kursorTrail.style.top = `${yTrail - 6}px`;
    kursorTrail.style.opacity = '0.4';
});

// Perbesar Kursor Saat Menyentuh Tombol
document.querySelectorAll('a, button').forEach(el => {
    el.addEventListener('mouseenter', () => {
        kursorUtama.style.width = '30px';
        kursorUtama.style.height = '30px';
        kursorUtama.style.marginLeft = '-10px';
        kursorUtama.style.marginTop = '-10px';
    });
    el.addEventListener('mouseleave', () => {
        kursorUtama.style.width = '20px';
        kursorUtama.style.height = '20px';
        kursorUtama.style.marginLeft = '0';
        kursorUtama.style.marginTop = '0';
    });
});

// Animasi Bilah Kemajuan
const pengamatKemajuan = new IntersectionObserver((entri) => {
    entri.forEach(item => {
        if (item.isIntersecting) {
            const target = item.target;
            const nilai = target.dataset.progress;
            target.style.width = `${nilai}%`;
            target.style.transition = 'width 1.5s ease-out';
        }
    });
}, { threshold: 0.5 });

document.querySelectorAll('[data-progress]').forEach(el => {
    pengamatKemajuan.observe(el);
});

// Tombol Kembali ke Atas
const tombolAtas = document.getElementById('tombolAtas');
window.addEventListener('scroll', () => {
    if (window.scrollY > 500) {
        tombolAtas.classList.remove('opacity-0', 'invisible');
        tombolAtas.classList.add('opacity-100', 'visible');
    } else {
        tombolAtas.classList.add('opacity-0', 'invisible');
        tombolAtas.classList.remove('opacity-100', 'visible');
    }
});

tombolAtas.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
});

// Navbar Aktif Saat Digulir
const bagian = document.querySelectorAll('section');
const tautanNav = document.querySelectorAll('.nav-link');

window.addEventListener('scroll', () => {
    let posisiSaatIni = window.scrollY + 100;
    bagian.forEach(bag => {
        const atasBagian = bag.offsetTop;
        const tinggiBagian = bag.offsetHeight;
        const idBagian = bag.getAttribute('id');
        
        if (posisiSaatIni >= atasBagian && posisiSaatIni < atasBagian + tinggiBagian) {
            tautanNav.forEach(taut => taut.classList.remove('active'));
            document.querySelector(`.nav-link[href="#${idBagian}"]`).classList.add('active');
        }
    });
});

