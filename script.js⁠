// Initialize Icons
lucide.createIcons();

// Hide Loading Screen with Transition
window.addEventListener('load', () => {
  setTimeout(() => {
    const loadingScreen = document.getElementById('loading-screen');
    loadingScreen.style.opacity = '0';
    setTimeout(() => loadingScreen.style.display = 'none', 1000);
    
    // Trigger Counters
    startCounters();
  }, 3000);
});

// Custom Neon Cursor Motion
const cursor = document.querySelector('.neon-cursor');
document.addEventListener('mousemove', (e) => {
  cursor.style.left = e.clientX + 'px';
  cursor.style.top = e.clientY + 'px';
});

// Counter Animation
function startCounters() {
  const counters = document.querySelectorAll('.counter');
  counters.forEach(counter => {
    const target = +counter.getAttribute('data-target');
    let count = 0;
    const speed = target / 100;

    const updateCount = () => {
      count += speed;
      if (count < target) {
        counter.innerText = Math.ceil(count);
        setTimeout(updateCount, 20);
      } else {
        counter.innerText = target;
      }
    };
    updateCount();
  });
}

// Live Typing Simulation for Terminal
const codeSnippet = `> Initializing Cyber Security Protocols...
> Connecting to Global Node Array... [SUCCESS]
> Fetching Blockchain Asset Balances...
> System Status: ALL SYSTEMS OPERATIONAL (60 FPS)`;

let charIndex = 0;
function typeCode() {
  if (charIndex < codeSnippet.length) {
    document.getElementById("typed-code").innerHTML += codeSnippet.charAt(charIndex);
    charIndex++;
    setTimeout(typeCode, 30);
  }
}
setTimeout(typeCode, 3500);

// Basic 3D Scene Setup (Three.js Earth / Particle Core)
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
const renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('cyber-bg'), alpha: true });

renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(window.devicePixelRatio);

// Sphere Object (Digital Earth Core)
const geometry = new THREE.SphereGeometry(2, 32, 32);
const material = new THREE.MeshBasicMaterial({ 
  color: 0x00f3ff, 
  wireframe: true 
});
const sphere = new THREE.Mesh(geometry, material);
scene.add(sphere);

camera.position.z = 5;

// Animation Loop for 60FPS Performance
function animate() {
  requestAnimationFrame(animate);
  sphere.rotation.x += 0.003;
  sphere.rotation.y += 0.005;
  renderer.render(scene, camera);
}
animate();

// Window Resize Handling
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});
