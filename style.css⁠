/* Custom Styles for Command Center & Futuristic UI */

/* Glassmorphism Effect */
.glass-card {
    background: rgba(8, 14, 30, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
}

/* RGB Animated Ring */
@keyframes spin-gradient {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.rgb-ring {
    position: relative;
    background: linear-gradient(0deg, #00f0ff, #7000ff, #ffd700, #00f0ff);
    background-size: 300% 300%;
    animation: spin-gradient 4s linear infinite;
}

/* Scanline Effect */
.scanline {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(0, 240, 255, 0.05) 51%);
    background-size: 100% 4px;
    pointer-events: none;
    border-radius: 1rem;
}

/* Glitch Animation */
@keyframes glitch {
    0% { text-shadow: 2px 0 #00f0ff, -2px 0 #7000ff; }
    50% { text-shadow: -2px 0 #00f0ff, 2px 0 #7000ff; }
    100% { text-shadow: 2px 0 #00f0ff, -2px 0 #7000ff; }
}

.glitch-text {
    animation: glitch 1.5s infinite alternate;
}

/* Glow Text Effect */
.glow-text {
    text-shadow: 0 0 10px rgba(0, 240, 255, 0.5), 0 0 20px rgba(112, 0, 255, 0.3);
}

/* Scrollbar Customization */
::-webkit-scrollbar {
    width: 6px;
}
::-webkit-scrollbar-track {
    background: #020617;
}
::-webkit-scrollbar-thumb {
    background: #1e293b;
    border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
    background: #00f0ff;
}
