:root {
  --primary-neon: #00f3ff;
  --secondary-neon: #7000ff;
  --accent-pink: #ff0055;
  --bg-dark: #030712;
  --glass-bg: rgba(255, 255, 255, 0.03);
  --glass-border: rgba(0, 243, 255, 0.2);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  cursor: none; /* Custom neon cursor */
}

body {
  background-color: var(--bg-dark);
  color: #fff;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  overflow-x: hidden;
}

/* 3D Canvas Background */
#cyber-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
}

/* Opening Cinematic Loading Screen */
#loading-screen {
  position: fixed;
  inset: 0;
  background: var(--bg-dark);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  transition: opacity 1s ease, visibility 1s;
}

.progress-bar-container {
  width: 300px;
  height: 4px;
  background: rgba(255, 255, 255, 0.1);
  margin-top: 20px;
  border-radius: 2px;
  overflow: hidden;
}

.progress-bar-fill {
  width: 0%;
  height: 100%;
  background: linear-gradient(90deg, var(--primary-neon), var(--secondary-neon), var(--accent-pink));
  animation: loadProgress 3s ease forwards;
}

@keyframes loadProgress {
  to { width: 100%; }
}

/* Liquid Glass UI */
.glass-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--glass-border);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  transition: all 0.3s ease;
}

.glass-card:hover {
  border-color: var(--primary-neon);
  box-shadow: 0 0 25px rgba(0, 243, 255, 0.4);
  transform: translateY(-5px) scale(1.01);
}

/* AI Hologram Assistant */
.hologram-assistant {
  position: fixed;
  bottom: 30px;
  right: 30px;
  display: flex;
  align-items: center;
  gap: 15px;
  z-index: 100;
}

.hologram-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  border: 2px solid var(--primary-neon);
  box-shadow: 0 0 15px var(--primary-neon);
  position: relative;
  animation: float 3s ease-in-out infinite;
}

.scan-line {
  position: absolute;
  top: 0; width: 100%; height: 2px;
  background: var(--primary-neon);
  animation: scan 2s linear infinite;
}

/* Neon Cursor */
.neon-cursor {
  width: 12px;
  height: 12px;
  background: var(--primary-neon);
  border-radius: 50%;
  position: fixed;
  pointer-events: none;
  box-shadow: 0 0 10px var(--primary-neon), 0 0 20px var(--primary-neon);
  z-index: 10000;
  transform: translate(-50%, -50%);
}

/* Animations */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes scan {
  0% { top: 0; }
  100% { top: 100%; }
}

/* Responsive Grids */
.grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
.grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
.grid-crypto { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; }
.command-center-container { padding: 80px 40px; display: flex; flex-direction: column; gap: 50px; }
